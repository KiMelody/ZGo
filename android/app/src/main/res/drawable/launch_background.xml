<?xml version="1.0" encoding="utf-8"?>
<!-- Stage-2 launch background (light): splash bg color + the centered
     stage-2 art at 512dp. Art is generated by tool/icon_gen.dart; the night
     variant lives in drawable-night/launch_background.xml. Layer-list item
     sizing is API 23+ (minSdk 24), so a density bucket scales to 512dp. -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:drawable="@color/splash_bg" />
    <item
        android:width="512dp"
        android:height="512dp"
        android:gravity="center">
        <bitmap
            android:gravity="fill"
            android:src="@drawable/launch_art" />
    </item>
</layer-list>
