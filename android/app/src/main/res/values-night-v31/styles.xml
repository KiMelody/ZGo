<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Night variant of values-v31. The night qualifier outranks the version
         qualifier in resource matching, so without this file a night + API 31
         device resolves values-night/styles.xml and drops the splash
         background. Only LaunchTheme is overridden here. -->
    <style name="LaunchTheme" parent="@android:style/Theme.Black.NoTitleBar">
        <item name="android:windowBackground">@drawable/launch_background</item>
        <item name="android:windowSplashScreenBackground">@color/splash_bg_brand</item>
        <item name="android:windowSplashScreenAnimatedIcon">@drawable/ic_splash</item>
    </style>
</resources>
