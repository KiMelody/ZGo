<?xml version="1.0" encoding="utf-8"?>
<!-- Stage-2 launch background (night): same layer-list as the day variant;
     @color/splash_bg and @drawable/launch_art resolve to their night
     resources (generated by tool/icon_gen.dart). -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:drawable="@color/splash_bg" />
    <item
        android:width="512dp"
        android:height="512dp"
        android:gravity="center">
        <bitmap
            android:gravity="fill"
            android:src="@drawable/launch_art" />
    </item>
</layer-list>
